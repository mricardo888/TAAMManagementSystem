<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/beige"
    android:layout_gravity="center"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/form_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/form_title"
            android:textColor="@color/olive"
            android:fontFamily="@font/idiqlat_regular"
            android:textSize="24sp" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginTop="16dp">

            <!-- A ScrollView can only have one direct child -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/edit_image_preview"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_horizontal"
                    android:scaleType="centerCrop"
                    android:src="@drawable/expanded_artifact_placeholder" />

                <Button
                    android:id="@+id/change_image_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="@string/change_image"
                    android:textAllCaps="false"
                    android:textColor="@color/olive" />

                <EditText
                    android:id="@+id/artifact_lot_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:hint="@string/lot_number"
                    android:inputType="number"
                    android:textColorHint="@color/olive"
                    android:alpha="0.67"
                    android:backgroundTint="@color/olive" />

                <EditText
                    android:id="@+id/artifact_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:hint="@string/name"
                    android:textColorHint="@color/olive"
                    android:alpha="0.67"
                    android:backgroundTint="@color/olive" />

                <EditText
                    android:id="@+id/artifact_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="top"
                    android:hint="@string/description"
                    android:inputType="textMultiLine"
                    android:textColorHint="@color/olive"
                    android:alpha="0.67"
                    android:backgroundTint="@color/olive" />

                <Spinner
                    android:id="@+id/artifact_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:minHeight="48dp"
                    android:spinnerMode="dropdown" />

                <Spinner
                    android:id="@+id/artifact_material"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:minHeight="48dp"
                    android:spinnerMode="dropdown" />

                <Spinner
                    android:id="@+id/artifact_dynasty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:minHeight="48dp"
                    android:spinnerMode="dropdown" />

                <EditText
                    android:id="@+id/artifact_origin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:hint="@string/origin"
                    android:textColorHint="@color/olive"
                    android:alpha="0.67"
                    android:backgroundTint="@color/olive" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/artifact_dimension_length"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/dimension_length"
                        android:inputType="numberDecimal"
                        android:textColorHint="@color/olive"
                        android:alpha="0.67"
                        android:backgroundTint="@color/olive" />

                    <EditText
                        android:id="@+id/artifact_dimension_width"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:hint="@string/dimension_width"
                        android:inputType="numberDecimal"
                        android:textColorHint="@color/olive"
                        android:alpha="0.67"
                        android:backgroundTint="@color/olive" />

                    <EditText
                        android:id="@+id/artifact_dimension_height"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:hint="@string/dimension_height"
                        android:inputType="numberDecimal"
                        android:textColorHint="@color/olive"
                        android:alpha="0.67"
                        android:backgroundTint="@color/olive" />

                </LinearLayout>

                <EditText
                    android:id="@+id/artifact_condition_report"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="top"
                    android:hint="@string/condition_report"
                    android:inputType="textMultiLine"
                    android:textColorHint="@color/olive"
                    android:alpha="0.67"
                    android:backgroundTint="@color/olive" />

                <EditText
                    android:id="@+id/artifact_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:hint="@string/location"
                    android:textColorHint="@color/olive"
                    android:alpha="0.67"
                    android:backgroundTint="@color/olive" />

                <EditText
                    android:id="@+id/artifact_acquisition_method"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:hint="@string/acquisition_method"
                    android:textColorHint="@color/olive"
                    android:alpha="0.67"
                    android:backgroundTint="@color/olive" />

                <EditText
                    android:id="@+id/artifact_provenance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="top"
                    android:hint="@string/provenance"
                    android:inputType="textMultiLine"
                    android:textColorHint="@color/olive"
                    android:alpha="0.67"
                    android:backgroundTint="@color/olive" />

                <EditText
                    android:id="@+id/artifact_accession_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:hint="@string/accession_number"
                    android:inputType="number"
                    android:textColorHint="@color/olive"
                    android:alpha="0.67"
                    android:backgroundTint="@color/olive" />

                <EditText
                    android:id="@+id/artifact_notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="top"
                    android:hint="@string/notes"
                    android:inputType="textMultiLine"
                    android:textColorHint="@color/olive"
                    android:alpha="0.67"
                    android:backgroundTint="@color/olive" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/olive" />

            <Button
                android:id="@+id/save_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/olive" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
