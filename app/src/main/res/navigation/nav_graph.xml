<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.golden.geese.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_testNavFragment"
            app:destination="@id/testNavFragment" />
    </fragment>
    <fragment
        android:id="@+id/testNavFragment"
        android:name="com.golden.geese.TestNavFragment"
        android:label="fragment_test_nav"
        tools:layout="@layout/fragment_test_nav" >
        <action
            android:id="@+id/action_testNavFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
</navigation>